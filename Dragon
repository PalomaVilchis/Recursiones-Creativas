import numpy as np
import matplotlib.pyplot as plt
from matplotlib.collections import LineCollection

print("Listo. Herramientas cargadas.")


def generar_curva_dragon(iteraciones=14):
    
    puntos = np.array([[0.0, 0.0], [1.0, 0.0]])   # la tira sin doblar

    for _ in range(iteraciones):
        pivote = puntos[-1]                        # el extremo de la tira
        rot = np.array([[0.0, 1.0], [-1.0, 0.0]])  # rotación de 90°
        copia = (puntos - pivote) @ rot.T + pivote
        puntos = np.vstack([puntos, copia[::-1][1:]])

    return puntos

print("Función definida.")

puntos = generar_curva_dragon(iteraciones=4)

plt.figure(figsize=(6, 6))
plt.plot(puntos[:, 0], puntos[:, 1], 'o-', color='crimson', linewidth=2, markersize=4)
plt.title('Curva del dragón — N dobleces\n(compara)')
plt.axis('equal')
plt.axis('off')
plt.show()


