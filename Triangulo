import numpy as np
import matplotlib.pyplot as plt
from matplotlib.collections import LineCollection


def sierpinski_por_remocion(nivel, ax):

    def dividir(v, n):
        if n == 0:
            ax.fill(v[:, 0], v[:, 1], color='darkgreen')
            return
        # Puntos medios de los tres lados
        m = np.array([(v[0] + v[1]) / 2, (v[1] + v[2]) / 2, (v[2] + v[0]) / 2])
        # Los tres triángulos de las esquinas (el de en medio se descarta)
        dividir(np.array([v[0], m[0], m[2]]), n - 1)
        dividir(np.array([v[1], m[1], m[0]]), n - 1)
        dividir(np.array([v[2], m[2], m[1]]), n - 1)

    inicial = np.array([[0, 0], [1, 0], [0.5, np.sqrt(3) / 2]])
    dividir(inicial, nivel)
    ax.set_title(f'Nivel {nivel}')
    ax.set_aspect('equal')
    ax.axis('off')


fig, axes = plt.subplots(1, 5, figsize=(16, 3.5))
for ax, nivel in zip(axes, range(5)):
    sierpinski_por_remocion(nivel, ax)

plt.show()

