def sierpinski_caos(n_puntos=80_000):
    vertices = np.array([[0, 0], [1, 0], [0.5, np.sqrt(3) / 2]])
    punto = np.random.rand(2)
    puntos = np.zeros((n_puntos, 2))

    for i in range(n_puntos):
        vertice = vertices[np.random.randint(0, 3)]   # vértice al azar
        punto = (punto + vertice) / 2                 # la mitad del camino
        puntos[i] = punto

    plt.figure(figsize=(8, 7))
    plt.scatter(puntos[:, 0], puntos[:, 1], s=0.05, color='darkgreen')

    plt.axis('equal')
    plt.axis('off')
    plt.show()


sierpinski_caos()

