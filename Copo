import numpy as np
import matplotlib.pyplot as plt
from matplotlib.collections import LineCollection

def _koch_segmento(p1, p2, nivel):
    if nivel == 0:
        return [p1, p2]
    p1, p2 = np.array(p1), np.array(p2)
    d = (p2 - p1) / 3
    a, b = p1 + d, p1 + 2 * d
    ang = np.pi / 3
    rot = np.array([[np.cos(ang), -np.sin(ang)],
                    [np.sin(ang),  np.cos(ang)]])
    pico = a + rot @ d
    return (_koch_segmento(p1, a, nivel - 1)[:-1] +
            _koch_segmento(a, pico, nivel - 1)[:-1] +
            _koch_segmento(pico, b, nivel - 1)[:-1] +
            _koch_segmento(b, p2, nivel - 1))


def copo_koch(nivel=4):
    v = [np.array([0, 0]), np.array([1, 0]), np.array([0.5, -np.sqrt(3) / 2])]
    puntos = (_koch_segmento(v[0], v[1], nivel)[:-1] +
              _koch_segmento(v[1], v[2], nivel)[:-1] +
              _koch_segmento(v[2], v[0], nivel))
    puntos = np.array(puntos)

    plt.figure(figsize=(8, 8))
    plt.plot(puntos[:, 0], puntos[:, 1], color='blue', linewidth=1)
    plt.fill(puntos[:, 0], puntos[:, 1], color='lightblue', alpha=0.4)
    plt.title(f'Copo de nieve de Koch — nivel {nivel}')
    plt.axis('equal')
    plt.axis('off')
    plt.show()

copo_koch(nivel=4)
