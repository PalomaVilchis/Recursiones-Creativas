import numpy as np
import matplotlib.pyplot as plt
from mpl_toolkits.mplot3d import Axes3D 

def yoshimura_clasico(filas=6, columnas=8, ancho=1.0, alto=1.0):
    fig, ax = plt.subplots(figsize=(10, 7))

    for f in range(filas):
        y0, y1 = f * alto, (f + 1) * alto
        desfase = 0.5 * ancho if f % 2 else 0.0   # filas alternadas

        # Pliegues valle: líneas horizontales entre filas
        ax.plot([0, columnas * ancho], [y0, y0], 'b--', lw=1)

        # Pliegues montaña: el zigzag diagonal de cada fila
        for col in range(columnas + 1):
            x = col * ancho + desfase
            ax.plot([x - 0.5 * ancho, x], [y0, y1], 'r-', lw=1.4)
            ax.plot([x, x + 0.5 * ancho], [y1, y0], 'r-', lw=1.4)

    ax.plot([0, columnas * ancho], [filas * alto] * 2, 'b--', lw=1)
    ax.set_xlim(0, columnas * ancho)
    ax.set_ylim(0, filas * alto)
    ax.set_aspect('equal')
    ax.axis('off')
    ax.set_title('Patrón Yoshimura\n(rojo continuo = montaña, azul discontinuo = valle)')
    plt.show()

yoshimura_clasico(filas=6, columnas=8)


