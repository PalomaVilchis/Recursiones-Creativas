def _onda_triangular(t):

    return 2 * np.abs(2 * ((t / (2 * np.pi)) % 1) - 1) - 1


def yoshimura_3d(n_diamantes=9, filas=6, radio=1.0, amplitud=0.15, altura=3.0):
    theta = np.linspace(0, 2 * np.pi, 400)
    z = np.linspace(0, altura, 300)
    T, Zg = np.meshgrid(theta, z)

    fase_fila = np.pi / n_diamantes
    fila = np.floor(Zg / (altura / filas))
    zig = _onda_triangular(n_diamantes * T + fila * n_diamantes * fase_fila)
    zag = _onda_triangular(np.pi * filas * Zg / altura)

    R = radio + amplitud * zig * zag   # modulación en rombos

    X, Y = R * np.cos(T), R * np.sin(T)

    fig = plt.figure(figsize=(8, 9))
    ax = fig.add_subplot(111, projection='3d')
    ax.plot_surface(X, Y, Zg, cmap='cividis', rstride=2, cstride=2,
                    linewidth=0, antialiased=True)
    ax.set_box_aspect((1, 1, 1.4))
    ax.axis('off')
    ax.set_title('Cilindro con pandeo tipo Yoshimura')
    plt.show()


yoshimura_3d(n_diamantes=8, filas=6)
